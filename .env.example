# Copy to .env.local and fill in. .env* is gitignored except this file.
# Never commit real values. Never expose ASSEMBLYAI_API_KEY to the browser —
# the browser only ever receives short-lived, single-use tokens minted by our
# own server.

ASSEMBLYAI_API_KEY=
DATABASE_URL=

# Output of publishing agents/qualify-owner.jsonc. Optional — without it
# the qualify screen configures the agent inline.
QUALIFY_AGENT_ID=

# Public base URL of the deployed app.
PUBLIC_APP_URL=http://localhost:3000

# Corretor identity for the non-editable CRECI block. Never commit values.
CORRETOR_FULL_NAME=
CORRETOR_CRECI=
